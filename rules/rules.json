 "project_roots_macos": [
  "{home}/All projects",
  "{home}/Dev",
  "{home}/Projects",
  "{home}/code",
  "{home}/src",
  "{home}/Developer",
  "{home}/Documents/GitHub"
 ],
 "project_roots_windows": [
  "{home}/source/repos",
  "{home}/Projects",
  "{home}/Dev",
  "{home}/code",
  "{home}/Documents/GitHub"
 ],
 "safe_idle_days": 30,
 "recent_days": 14,
 "known_daemons": [
  "codebase-memory-mcp --cbm-daemon-internal",
  "pm2",
  "ollama serve"
 ],
 "dev_process_patterns": [
  "node",
  "npm",
  "npx",
  "python",
  "python3",
  "uv",
  "bun",
  "deno",
  "tsserver",
  "esbuild",
  "vite",
  "next-server",
  "turbopack"
 ],
 "extra_never": [],
 "thresholds": {
  "free_pct": 15,
  "swap_pct": 75,
  "growth_gb": 5
 },
 "retention": {
  "safe_days": 3,
  "review_days": 30,
  "volume_backup_days": 30
 },
 "auto_clean": false
}