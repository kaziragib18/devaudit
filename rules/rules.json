{
 "targets": [
  {
   "id": "npm-cacache",
   "os": "Any",
   "title": "npm package cache",
   "category": "PackageCache",
   "path": "{npm_cache}/_cacache",
   "tier": "Safe",
   "method": "Vault",
   "rebuild": "Re-downloads packages on the next install",
   "min_idle_days": 0,
   "owner_processes": [
    "npm",
    "npx",
    "npm-cli",
    "npx-cli"
   ]
  },
  {
   "id": "npm-npx",
   "os": "Any",
